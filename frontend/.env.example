# ==============================================================================
# CIVORA AI Frontend Configuration
# ==============================================================================

# Optional CARTO Basemaps API Key
# If provided, enables authentic CARTO hosted raster tiles (Dark Matter, Voyager).
# Free registration (5,000,000 tile requests/month) at: https://carto.com/basemaps/apikey
# If left empty, CIVORA automatically falls back to Esri Dark Canvas & World Imagery
# which are 100% free with NO API keys, NO registration, and NO watermarks!
VITE_CARTO_API_KEY=

# Backend API Base URL
# Default in development: http://127.0.0.1:8000
# In production on Vercel: set to your AWS backend public domain/HTTPS URL
VITE_API_URL=http://127.0.0.1:8000
